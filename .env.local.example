# =====================================================================
# STARTUP RUN — 환경변수
# 이 파일을 .env.local로 복사한 뒤 실제 값 채우기.
# .env.local은 .gitignore되어 있음.
# =====================================================================

# ── Supabase 프로젝트 (https://app.supabase.com 에서 생성) ─────────
# Settings → API 페이지에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 (절대 클라이언트에 노출 X — Edge Function/서버 전용)
SUPABASE_SERVICE_ROLE_KEY=

# ── Anti-cheat HMAC (Supabase Edge Function 시크릿) ──────────────────
# 자동 생성: openssl rand -hex 32
# 또는 npm run supabase:secrets (setup-supabase.sh 안에서 자동 생성됨)
SCORE_HMAC_SECRET=

# ── 대회 공식 홈페이지 URL (사망 화면 CTA 진입점) ──────────────────
# 대회 측 확정 시 채움
NEXT_PUBLIC_OFFICIAL_URL=https://example.com

# ── og:image 절대 URL용 (선택, Vercel 배포 시 자동 설정됨) ─────────
# NEXT_PUBLIC_BASE_URL=https://startup-run.vercel.app

# ── 대회 마감일 (D-day 카운터) ──────────────────────────────────
# 미설정 시 src/lib/constants.ts의 placeholder (2026-12-31) 사용
# 대회 측 확정 시 ISO 8601 + KST timezone으로 (예: 2026-08-15T23:59:59+09:00)
NEXT_PUBLIC_CAMPAIGN_DEADLINE=
